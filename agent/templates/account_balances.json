{
  "templateId": "account_balances",
  "version": "1.1.0",
  "approvedBy": "Legal Team",
  "approvedDate": "2026-03-15",
  "description": "Account balances overview — banking and investing sections with per-account ListItem rows",
  "intentTriggers": {
    "exact": [["account", "balance"], ["account", "balances"]],
    "keywords": ["balance", "balances", "net worth", "worth"]
  },
  "dataSchema": {
    "source": "mock",
    "fields": {
      "bankLabel":   { "type": "string", "apiPath": "banking.sectionLabel" },
      "bankTotal":   { "type": "string", "apiPath": "banking.total" },
      "chkName":     { "type": "string", "apiPath": "banking.checking.name" },
      "chkNum":      { "type": "string", "apiPath": "banking.checking.accountNumber" },
      "chkBal":      { "type": "string", "apiPath": "banking.checking.balance" },
      "chkChg":      { "type": "string", "apiPath": "banking.checking.change" },
      "savName":     { "type": "string", "apiPath": "banking.savings.name" },
      "savNum":      { "type": "string", "apiPath": "banking.savings.accountNumber" },
      "savBal":      { "type": "string", "apiPath": "banking.savings.balance" },
      "savChg":      { "type": "string", "apiPath": "banking.savings.change" },
      "invLabel":    { "type": "string", "apiPath": "investing.sectionLabel" },
      "invTotal":    { "type": "string", "apiPath": "investing.total" },
      "brokName":    { "type": "string", "apiPath": "investing.brokerage.name" },
      "brokNum":     { "type": "string", "apiPath": "investing.brokerage.accountNumber" },
      "brokBal":     { "type": "string", "apiPath": "investing.brokerage.balance" },
      "brokChg":     { "type": "string", "apiPath": "investing.brokerage.change" },
      "rothName":    { "type": "string", "apiPath": "investing.rothIra.name" },
      "rothNum":     { "type": "string", "apiPath": "investing.rothIra.accountNumber" },
      "rothBal":     { "type": "string", "apiPath": "investing.rothIra.balance" },
      "rothChg":     { "type": "string", "apiPath": "investing.rothIra.change" },
      "k401Name":    { "type": "string", "apiPath": "investing.k401.name" },
      "k401Num":     { "type": "string", "apiPath": "investing.k401.accountNumber" },
      "k401Bal":     { "type": "string", "apiPath": "investing.k401.balance" },
      "k401Chg":     { "type": "string", "apiPath": "investing.k401.change" },
      "totalLabel":  { "type": "string", "apiPath": "netWorth.label" },
      "totalValue":  { "type": "string", "apiPath": "netWorth.value" },
      "summaryText": { "type": "string", "apiPath": "summary.text" }
    }
  },
  "textTemplate": "${summaryText}\n\n${bankLabel}  ${bankTotal}\n  ${chkName} ${chkNum}  ${chkBal}  ${chkChg}\n  ${savName} ${savNum}  ${savBal}  ${savChg}\n\n${invLabel}  ${invTotal}\n  ${brokName} ${brokNum}  ${brokBal}  ${brokChg}\n  ${rothName} ${rothNum}  ${rothBal}  ${rothChg}\n  ${k401Name} ${k401Num}  ${k401Bal}  ${k401Chg}\n\n${totalLabel}  ${totalValue}",
  "uiDefinition": {
    "root": "root",
    "components": {
      "root": {
        "id": "root",
        "componentProperties": {
          "Column": {
            "children": { "explicitList": ["main_card"] }
          }
        }
      },
      "main_card": {
        "id": "main_card",
        "componentProperties": {
          "Card": {
            "child": "main_col"
          }
        }
      },
      "main_col": {
        "id": "main_col",
        "componentProperties": {
          "Column": {
            "children": {
              "explicitList": [
                "summary_text",
                "bank_section_row",
                "chk_item",
                "sav_item",
                "divider1",
                "inv_section_row",
                "brok_item",
                "roth_item",
                "k401_item",
                "divider2",
                "total_row"
              ]
            }
          }
        }
      },
      "summary_text": {
        "id": "summary_text",
        "componentProperties": {
          "Text": {
            "text": { "literalString": "${summaryText}" },
            "usageHint": "caption"
          }
        }
      },
      "bank_section_row": {
        "id": "bank_section_row",
        "componentProperties": {
          "Row": {
            "children": { "explicitList": ["bank_label", "bank_total"] },
            "distribution": "spaceBetween"
          }
        }
      },
      "bank_label": {
        "id": "bank_label",
        "componentProperties": {
          "Text": {
            "text": { "literalString": "${bankLabel}" },
            "usageHint": "h5"
          }
        }
      },
      "bank_total": {
        "id": "bank_total",
        "componentProperties": {
          "Text": {
            "text": { "literalString": "${bankTotal}" },
            "usageHint": "h5"
          }
        }
      },
      "chk_item": {
        "id": "chk_item",
        "componentProperties": {
          "ListItem": {
            "label":    { "literalString": "${chkName}" },
            "subLabel": { "literalString": "${chkNum}" },
            "value":    { "literalString": "${chkBal}" },
            "subValue": { "literalString": "${chkChg}" }
          }
        }
      },
      "sav_item": {
        "id": "sav_item",
        "componentProperties": {
          "ListItem": {
            "label":    { "literalString": "${savName}" },
            "subLabel": { "literalString": "${savNum}" },
            "value":    { "literalString": "${savBal}" },
            "subValue": { "literalString": "${savChg}" }
          }
        }
      },
      "divider1": {
        "id": "divider1",
        "componentProperties": {
          "Divider": {}
        }
      },
      "inv_section_row": {
        "id": "inv_section_row",
        "componentProperties": {
          "Row": {
            "children": { "explicitList": ["inv_label", "inv_total"] },
            "distribution": "spaceBetween"
          }
        }
      },
      "inv_label": {
        "id": "inv_label",
        "componentProperties": {
          "Text": {
            "text": { "literalString": "${invLabel}" },
            "usageHint": "h5"
          }
        }
      },
      "inv_total": {
        "id": "inv_total",
        "componentProperties": {
          "Text": {
            "text": { "literalString": "${invTotal}" },
            "usageHint": "h5"
          }
        }
      },
      "brok_item": {
        "id": "brok_item",
        "componentProperties": {
          "ListItem": {
            "label":    { "literalString": "${brokName}" },
            "subLabel": { "literalString": "${brokNum}" },
            "value":    { "literalString": "${brokBal}" },
            "subValue": { "literalString": "${brokChg}" }
          }
        }
      },
      "roth_item": {
        "id": "roth_item",
        "componentProperties": {
          "ListItem": {
            "label":    { "literalString": "${rothName}" },
            "subLabel": { "literalString": "${rothNum}" },
            "value":    { "literalString": "${rothBal}" },
            "subValue": { "literalString": "${rothChg}" }
          }
        }
      },
      "k401_item": {
        "id": "k401_item",
        "componentProperties": {
          "ListItem": {
            "label":    { "literalString": "${k401Name}" },
            "subLabel": { "literalString": "${k401Num}" },
            "value":    { "literalString": "${k401Bal}" },
            "subValue": { "literalString": "${k401Chg}" }
          }
        }
      },
      "divider2": {
        "id": "divider2",
        "componentProperties": {
          "Divider": {}
        }
      },
      "total_row": {
        "id": "total_row",
        "componentProperties": {
          "Row": {
            "children": { "explicitList": ["total_label", "total_value"] },
            "distribution": "spaceBetween"
          }
        }
      },
      "total_label": {
        "id": "total_label",
        "componentProperties": {
          "Text": {
            "text": { "literalString": "${totalLabel}" },
            "usageHint": "h5"
          }
        }
      },
      "total_value": {
        "id": "total_value",
        "componentProperties": {
          "Text": {
            "text": { "literalString": "${totalValue}" },
            "usageHint": "h4"
          }
        }
      }
    }
  }
}
