{
  "templateId": "transaction_history",
  "version": "1.0.0",
  "approvedBy": "Legal Team",
  "approvedDate": "2026-03-15",
  "description": "Monthly transaction history with header summary and scrollable transaction rows",
  "intentTriggers": {
    "exact": [["last", "transaction"], ["last", "transactions"], ["last", "trade"], ["show", "transactions"]],
    "keywords": ["transaction", "transactions", "transa", "history"]
  },
  "dataSchema": {
    "source": "mock",
    "fields": {
      "title":       { "type": "string", "apiPath": "period.label" },
      "periodLabel": { "type": "string", "apiPath": "period.label" },
      "periodRange": { "type": "string", "apiPath": "period.range" },
      "count":       { "type": "string", "apiPath": "transactions.count" },
      "countLabel":  { "type": "string", "apiPath": "transactions.countLabel" },
      "transactions": {
        "type": "array",
        "apiPath": "transactions.items",
        "itemSchema": {
          "action": { "type": "string" },
          "date":   { "type": "string" },
          "amount": { "type": "string" }
        }
      }
    }
  },
  "textTemplate": "${title}\n${periodRange}\n${countLabel}",
  "uiDefinition": {
    "root": "root",
    "components": {
      "root": {
        "id": "root",
        "componentProperties": {
          "Column": {
            "children": { "explicitList": ["hdr_card"] }
          }
        }
      },
      "hdr_card": {
        "id": "hdr_card",
        "componentProperties": {
          "Card": {
            "child": "hdr_card_col"
          }
        }
      },
      "hdr_card_col": {
        "id": "hdr_card_col",
        "componentProperties": {
          "Column": {
            "children": { "explicitList": ["hdr_col", "txns_list"] }
          }
        }
      },
      "hdr_col": {
        "id": "hdr_col",
        "componentProperties": {
          "Column": {
            "children": { "explicitList": ["title", "period", "count"] }
          }
        }
      },
      "title": {
        "id": "title",
        "componentProperties": {
          "Text": {
            "text": { "path": "/title" },
            "usageHint": "h5"
          }
        }
      },
      "period": {
        "id": "period",
        "componentProperties": {
          "Text": {
            "text": { "path": "/periodRange" },
            "usageHint": "caption"
          }
        }
      },
      "count": {
        "id": "count",
        "componentProperties": {
          "Text": {
            "text": { "path": "/countLabel" },
            "usageHint": "caption"
          }
        }
      },
      "txns_list": {
        "id": "txns_list",
        "componentProperties": {
          "List": {
            "children": { "path": "/transactions", "componentId": "t-template" }
          }
        }
      },
      "t-template": {
        "id": "t-template",
        "componentProperties": {
          "ListItem": {
            "label":    { "path": "action" },
            "value":    { "path": "amount" },
            "subValue": { "path": "date" }
          }
        }
      }
    }
  }
}
