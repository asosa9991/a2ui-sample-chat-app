{
  "templateId": "brokerage_activity",
  "version": "1.0.0",
  "approvedBy": "Legal Team",
  "approvedDate": "2026-03-15",
  "description": "Brokerage account overview with balance, change, and recent transaction rows",
  "textTemplate": "${acctName} (${acctType})\nBalance: ${balanceAmount}\nChange: ${balanceChange}\n\n${sectionHeader}",
  "uiDefinition": {
    "root": "root",
    "components": {
      "root": {
        "id": "root",
        "componentProperties": {
          "Column": {
            "children": { "explicitList": ["acct_card"] }
          }
        }
      },
      "acct_card": {
        "id": "acct_card",
        "componentProperties": {
          "Card": {
            "child": "card_col"
          }
        }
      },
      "card_col": {
        "id": "card_col",
        "componentProperties": {
          "Column": {
            "children": {
              "explicitList": [
                "header_row",
                "balance_amount",
                "balance_change",
                "divider_main",
                "tx_section_header",
                "tx_list"
              ]
            }
          }
        }
      },
      "header_row": {
        "id": "header_row",
        "componentProperties": {
          "Row": {
            "children": { "explicitList": ["acct_name", "acct_type"] },
            "distribution": "spaceBetween"
          }
        }
      },
      "acct_name": {
        "id": "acct_name",
        "componentProperties": {
          "Text": {
            "text": { "path": "/acctName" },
            "usageHint": "h5"
          }
        }
      },
      "acct_type": {
        "id": "acct_type",
        "componentProperties": {
          "Text": {
            "text": { "path": "/acctType" },
            "usageHint": "caption"
          }
        }
      },
      "balance_amount": {
        "id": "balance_amount",
        "componentProperties": {
          "Text": {
            "text": { "path": "/balanceAmount" },
            "usageHint": "h2"
          }
        }
      },
      "balance_change": {
        "id": "balance_change",
        "componentProperties": {
          "Text": {
            "text": { "path": "/balanceChange" },
            "usageHint": "caption"
          }
        }
      },
      "divider_main": {
        "id": "divider_main",
        "componentProperties": {
          "Divider": {}
        }
      },
      "tx_section_header": {
        "id": "tx_section_header",
        "componentProperties": {
          "Text": {
            "text": { "path": "/sectionHeader" },
            "usageHint": "h5"
          }
        }
      },
      "tx_list": {
        "id": "tx_list",
        "componentProperties": {
          "List": {
            "children": { "path": "/transactions", "componentId": "tx-template" }
          }
        }
      },
      "tx-template": {
        "id": "tx-template",
        "componentProperties": {
          "ListItem": {
            "label":    { "path": "description" },
            "subLabel": { "path": "subtitle" },
            "value":    { "path": "amount" },
            "subValue": { "path": "date" }
          }
        }
      }
    }
  }
}
