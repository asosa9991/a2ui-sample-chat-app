{
  "templateId": "brokerage_activity",
  "version": "1.0.0",
  "approvedBy": "Legal Team",
  "approvedDate": "2026-03-15",
  "description": "Brokerage account overview with balance, change, and recent transaction rows",
  "textTemplate": "${acctName} (${acctType})\nBalance: ${balanceAmount}\nChange: ${balanceChange}\n\n${sectionHeader}\n{{#transactions}}{{description}} — {{subtitle}}  {{date}}  {{amount}}\n{{/transactions}}",
  "uiDefinition": {
    "root": "root",
    "components": {
      "root": {
        "id": "root",
        "componentProperties": {
          "Column": {
            "children": { "explicitList": ["acct_card"] }
          }
        }
      },
      "acct_card": {
        "id": "acct_card",
        "componentProperties": {
          "Card": {
            "child": "card_col"
          }
        }
      },
      "card_col": {
        "id": "card_col",
        "componentProperties": {
          "Column": {
            "children": {
              "explicitList": [
                "header_row",
                "balance_amount",
                "balance_change",
                "divider_main",
                "tx_section_header",
                "tx_list"
              ]
            }
          }
        }
      },
      "header_row": {
        "id": "header_row",
        "componentProperties": {
          "Row": {
            "children": { "explicitList": ["acct_name", "acct_type"] },
            "distribution": "spaceBetween"
          }
        }
      },
      "acct_name": {
        "id": "acct_name",
        "componentProperties": {
          "Text": {
            "text": { "literalString": "${acctName}" },
            "usageHint": "h5"
          }
        }
      },
      "acct_type": {
        "id": "acct_type",
        "componentProperties": {
          "Text": {
            "text": { "literalString": "${acctType}" },
            "usageHint": "caption"
          }
        }
      },
      "balance_amount": {
        "id": "balance_amount",
        "componentProperties": {
          "Text": {
            "text": { "literalString": "${balanceAmount}" },
            "usageHint": "h2"
          }
        }
      },
      "balance_change": {
        "id": "balance_change",
        "componentProperties": {
          "Text": {
            "text": { "literalString": "${balanceChange}" },
            "usageHint": "caption"
          }
        }
      },
      "divider_main": {
        "id": "divider_main",
        "componentProperties": {
          "Divider": {}
        }
      },
      "tx_section_header": {
        "id": "tx_section_header",
        "componentProperties": {
          "Text": {
            "text": { "literalString": "${sectionHeader}" },
            "usageHint": "h5"
          }
        }
      },
      "tx_list": {
        "id": "tx_list",
        "componentProperties": {
          "Column": {
            "children": { "explicitList": [] }
          }
        }
      }
    },
    "itemTemplate": {
      "itemListId": "tx_list",
      "rootId": "tx_row_{i}",
      "dividerId": "tx_div_{i}",
      "components": {
        "tx_row_{i}": {
          "id": "tx_row_{i}",
          "componentProperties": {
            "Row": {
              "children": { "explicitList": ["tx_col_{i}", "tx_amount_{i}"] },
              "distribution": "spaceBetween"
            }
          }
        },
        "tx_col_{i}": {
          "id": "tx_col_{i}",
          "componentProperties": {
            "Column": {
              "children": { "explicitList": ["tx_desc_{i}", "tx_sub_{i}", "tx_date_{i}"] }
            }
          }
        },
        "tx_desc_{i}": {
          "id": "tx_desc_{i}",
          "componentProperties": {
            "Text": {
              "text": { "literalString": "{description}" },
              "usageHint": "body"
            }
          }
        },
        "tx_sub_{i}": {
          "id": "tx_sub_{i}",
          "componentProperties": {
            "Text": {
              "text": { "literalString": "{subtitle}" },
              "usageHint": "caption"
            }
          }
        },
        "tx_date_{i}": {
          "id": "tx_date_{i}",
          "componentProperties": {
            "Text": {
              "text": { "literalString": "{date}" },
              "usageHint": "caption"
            }
          }
        },
        "tx_amount_{i}": {
          "id": "tx_amount_{i}",
          "componentProperties": {
            "Text": {
              "text": { "literalString": "{amount}" },
              "usageHint": "body"
            }
          }
        }
      }
    }
  }
}
