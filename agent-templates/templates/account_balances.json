{
  "templateId": "account_balances",
  "version": "1.0.0",
  "approvedBy": "Legal Team",
  "approvedDate": "2026-03-15",
  "description": "Account balances overview with banking, investing, and total net worth sections",
  "textTemplate": "${bankLabel}: ${bankTotal}\n  ${chkName} ${chkNum}: ${chkBal} ${chkChg}\n  ${savName} ${savNum}: ${savBal} ${savChg}\n\n${invLabel}: ${invTotal}\n  ${brokName} ${brokNum}: ${brokBal} ${brokChg}\n  ${rothName} ${rothNum}: ${rothBal} ${rothChg}\n  ${k401Name} ${k401Num}: ${k401Bal} ${k401Chg}\n\n${totalLabel}: ${totalValue}",
  "uiDefinition": {
    "root": "root",
    "components": {
      "root": {
        "id": "root",
        "componentProperties": {
          "Column": {
            "children": { "explicitList": ["bank_card", "invest_card", "total_card"] }
          }
        }
      },

      "bank_card": {
        "id": "bank_card",
        "componentProperties": {
          "Card": {
            "child": "bank_col"
          }
        }
      },
      "bank_col": {
        "id": "bank_col",
        "componentProperties": {
          "Column": {
            "children": { "explicitList": ["bank_hdr", "bdiv1", "chk_row", "sav_row"] }
          }
        }
      },
      "bank_hdr": {
        "id": "bank_hdr",
        "componentProperties": {
          "Row": {
            "children": { "explicitList": ["bank_lbl", "bank_tot"] },
            "distribution": "spaceBetween"
          }
        }
      },
      "bank_lbl": {
        "id": "bank_lbl",
        "componentProperties": {
          "Text": {
            "text": { "literalString": "${bankLabel}" },
            "usageHint": "caption"
          }
        }
      },
      "bank_tot": {
        "id": "bank_tot",
        "componentProperties": {
          "Text": {
            "text": { "literalString": "${bankTotal}" },
